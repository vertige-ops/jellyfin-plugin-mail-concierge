<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Client/ holds the node tests of the web client script (run with node), not part of the .NET build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Client/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.MailConcierge\Jellyfin.Plugin.MailConcierge.csproj" />
  </ItemGroup>

</Project>
